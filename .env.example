# Copy this file to .env on the server and replace the example values.
QINGJIAN_DATA_DIR=/opt/qingjian/data
QINGJIAN_BIND_ADDRESS=127.0.0.1
QINGJIAN_PORT=8000
QINGJIAN_IMAGE_TAG=latest

# For a public HTTPS domain, keep true and use the exact external origin.
# For temporary direct HTTP access, set COOKIE_SECURE=false and use
# TRUSTED_ORIGINS=http://SERVER_IP:8000 instead.
COOKIE_SECURE=true
TRUSTED_ORIGINS=https://qingjian.example.com

# Keep one SQLite-backed app instance. Replace this only when using PostgreSQL.
DATABASE_URL=sqlite:////app/data/app.db

# The published port is loopback-only, so trusting proxy headers is safe when
# the reverse proxy runs on the same server. Restrict this when networking differs.
FORWARDED_ALLOW_IPS=*
